{
  "name": "@awssolutions/gen-ai-evaluation-toolkit-test",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "GenAI-ETK Integration Tests",
  "main": "jest.config.js",
  "scripts": {
    "clean": "rm -rf node_modules",
    "jest": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest",
    "test:short": "npm run jest ./test/shortRunningTests",
    "test:long-gtg": "npm run jest ./test/longRunningTests/gtg",
    "cleanup": "tsx test/cleanup.ts",
    "benchmark": "jest test/benchmarks",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache test && prettier --list-different --cache .",
    "format": "eslint --fix --cache test && prettier --write --cache .",
    "audit:fix": "npm audit fix"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "2.1.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "archiver": "^7.0.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "zx": "^8.5.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-ssm": "^3.1000.0",
    "@aws-sdk/client-sts": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@awssolutions/gen-ai-evaluation-cli": "file:../cli",
    "@awssolutions/gen-ai-evaluation-toolkit-ts-client": "file:../generated/ts-client",
    "@smithy/types": "^4.14.2",
    "ms": "2.1.3"
  },
  "private": true
}
