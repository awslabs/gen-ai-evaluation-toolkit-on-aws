{
  "name": "@awssolutions/gen-ai-evaluation-toolkit-deployment-cdk",
  "description": "AWS PSE GenAI-ETK deployment CDK",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "lib/app.ts",
  "scripts": {
    "prebuild": "./scripts/pre-build.sh",
    "build": "tsc --noEmit && rm -rf build/cdk.out && cdk synth",
    "typecheck": "tsc --noEmit",
    "cdk:bootstrap": "cdk bootstrap",
    "cdk:deploy": "cdk deploy --all --require-approval=never",
    "cdk:destroy": "cdk destroy -f --all",
    "lint": "eslint --cache lib && prettier --list-different --cache .",
    "fix": "eslint --fix --cache lib && prettier --write --cache .",
    "test": "jest --silent --coverage",
    "test:update": "jest --silent -u",
    "test:watch": "jest --watch",
    "clean": "rm -rf build cdk.out dist node_modules",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@awssolutions/gen-ai-evaluation-cdk": "file:../cdk",
    "@awssolutions/gen-ai-evaluation-toolkit-ts-ssdk": "file:../generated/ts-ssdk",
    "aws-cdk-lib": "^2.257.0",
    "aws-sdk-client-mock": "4.1.0",
    "cdk-ecr-deployment": "^4.1.1",
    "cdk-nag": "^2.35.35",
    "constructs": "^10.5.1",
    "openapi-types": "12.1.3",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "^9.18.0",
    "@stylistic/eslint-plugin-ts": "^2.10.1",
    "@tsconfig/strictest": "2.0.5",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/jest-specific-snapshot": "^0.5.8",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "aws-cdk": "^2.1126.0",
    "esbuild": ">=0.25.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.0.5",
    "jest-cdk-snapshot": "^2.2.5",
    "jest-specific-snapshot": "^8.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.19.2",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "{lib,test}/**/*.{js,ts}": [
      "eslint --fix"
    ]
  }
}
