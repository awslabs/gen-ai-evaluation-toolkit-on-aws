    "ParallelScoring": {
      "Type": "Map",
      "ItemsPath": "$.scoreTasks",
      "ItemSelector": {
        "jobId.$": "$.jobId",
        "reportId.$": "$.reportId",
        "experimentName.$": "$.experimentName",
        "continueBufferMs.$": "$.continueBufferMs",
        "scoreTask.$": "$$.Map.Item.Value",
        "heartbeatSeconds.$": "$.heartbeatSeconds"
      },
      "MaxConcurrency": 0,
      "Iterator": {
        "StartAt": "PrepareScoreTask",
        "States": {
          "PrepareScoreTask": {
            "Type": "Pass",
            "Parameters": {
              "jobId.$": "$.jobId",
              "reportId.$": "$.reportId",
              "experimentName.$": "$.experimentName",
              "continueBufferMs.$": "$.continueBufferMs",
              "taskKey.$": "$.scoreTask.taskKey",
              "evaluatorName.$": "$.scoreTask.evaluatorName",
              "scorers.$": "$.scoreTask.scorers",
              "checkpoint": null,
              "heartbeatSeconds.$": "$.heartbeatSeconds"
            },
            "Next": "EmitScoreTask"
          },
          "EmitScoreTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
            "Parameters": {
              "Entries": [
                {
                  "Source": "GenAiEvaluationToolkit",
                  "DetailType": "EvaluatorTaskDispatched",
                  "EventBusName": "",
              {
                "Fn::ImportValue": "GenAiEtk-Base:ExportsOutputRefEventBus7B8748AA3BA3246C",
              },
              "",
                  "Detail": {
                    "taskToken.$": "$$.Task.Token",
                    "taskKey.$": "$.taskKey",
                    "jobId.$": "$.jobId",
                    "reportId.$": "$.reportId",
                    "jobType": "SCORE",
                    "evaluatorName.$": "$.evaluatorName",
                    "scorers.$": "$.scorers",
                    "experimentName.$": "$.experimentName",
                    "checkpoint.$": "$.checkpoint",
                    "continueBufferMs.$": "$.continueBufferMs",
                    "heartbeatSeconds.$": "$.heartbeatSeconds"
                  }
                }
              ]
            },
            "ResultPath": "$.taskOutput",
            "Next": "CheckScoreResult",
            "Catch": [
              {
                "ErrorEquals": ["States.HeartbeatTimeout"],
                "Next": "EmitScoreTimeout",
                "ResultPath": "$.taskError"
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "Next": "ScoreTaskFailed",
                "ResultPath": "$.taskError"
              }
            ],
            "HeartbeatSecondsPath": "$.heartbeatSeconds"
          },
          "EmitScoreTimeout": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Parameters": {
              "Entries": [
                {
                  "Source": "GenAiEvaluationToolkit",
                  "DetailType": "EvaluatorTaskTimedOut",
                  "EventBusName": "",
              {
                "Fn::ImportValue": "GenAiEtk-Base:ExportsOutputRefEventBus7B8748AA3BA3246C",
              },
              "",
                  "Detail": {
                    "jobId.$": "$.jobId",
                    "taskKey.$": "$.taskKey"
                  }
                }
              ]
            },
            "ResultPath": null,
            "Next": "ScoreTaskFailed"
          },
          "CheckScoreResult": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.taskOutput.status",
                "StringEquals": "CONTINUE",
                "Next": "PrepareScoreContinue"
              }
            ],
            "Default": "ScoreTaskDone"
          },
          "PrepareScoreContinue": {
            "Type": "Pass",
            "Parameters": {
              "jobId.$": "$.jobId",
              "reportId.$": "$.reportId",
              "experimentName.$": "$.experimentName",
              "continueBufferMs.$": "$.continueBufferMs",
              "taskKey.$": "$.taskKey",
              "evaluatorName.$": "$.evaluatorName",
              "scorers.$": "$.scorers",
              "checkpoint.$": "$.taskOutput.checkpoint",
              "heartbeatSeconds.$": "$.heartbeatSeconds"
            },
            "Next": "EmitScoreTask"
          },
          "ScoreTaskDone": {
            "Type": "Pass",
            "Parameters": {
              "status": "COMPLETED",
              "taskKey.$": "$.taskKey"
            },
            "End": true
          },
          "ScoreTaskFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "taskKey.$": "$.taskKey"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.scoreResults",
      "Next": "EmitPostProcessTask",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EmitPostProcessTask",
          "ResultPath": "$.scoringError"
        }
      ]
    },
    "EmitPostProcessTask": {
      "Comment": "Internal task \\u2014 no evaluatorName, routed by jobType",
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
      "Parameters": {
        "Entries": [
          {
            "Source": "GenAiEvaluationToolkit",
