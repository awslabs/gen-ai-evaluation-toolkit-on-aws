      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-IAM5",
              "reason": "CloudWatch policy requires: 1) wildcard resource (Resource::*) for PutMetricData as metrics are not known in advance, 2) wildcard log group ARNs (ecs-aws-otel-collector*, *-task*, containerinsights/*) for ECS task logging and container insights, 3) wildcard SSM parameter (AmazonCloudWatch-*) for CloudWatch agent configuration. These are standard AWS patterns for ECS observability.",
            },
            {
              "id": "AwsSolutions-IAM5",
              "reason": "Plugins need unrestricted wildcard access to the evaluation bucket",
            },
          ],
        },
      },
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "cloudwatch:PutMetricData",
              "Effect": "Allow",
              "Resource": "*",
            },
            {
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
