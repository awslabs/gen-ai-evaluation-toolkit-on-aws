    "GenEcsAgenticCloudWatchPolicyEA722562": {
      "DependsOn": [
        "ECRDeploymentPluginGenAgenticCustomResourceB00CE665",
      ],
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-IAM5",
              "reason": "CloudWatch policy requires: 1) wildcard resource (Resource::*) for PutMetricData as metrics are not known in advance, 2) wildcard log group ARNs (ecs-aws-otel-collector*, *-task*, containerinsights/*) for ECS task logging and container insights, 3) wildcard SSM parameter (AmazonCloudWatch-*) for CloudWatch agent configuration. These are standard AWS patterns for ECS observability.",
            },
            {
              "id": "AwsSolutions-IAM5",
              "reason": "Plugins need unrestricted wildcard access to the evaluation bucket",
            },
          ],
        },
      },
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "cloudwatch:PutMetricData",
              "Effect": "Allow",
              "Resource": "*",
            },
            {
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "logs:DescribeLogStreams",
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":logs:us-east-1:123456789012:log-group//aws/ecs/ecs-aws-otel-collector*",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":logs:us-east-1:123456789012:log-group//aws/ecs/ecs-aws-otel-collector*:log-stream:*",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":logs:us-east-1:123456789012:log-group//aws/ecs/*-task*",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":logs:us-east-1:123456789012:log-group//aws/ecs/*-task*:log-stream:*",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":logs:us-east-1:123456789012:log-group//aws/ecs/containerinsights/",
                      {
                        "Ref": "GenEcsAgenticCluster67E30AF3",
                      },
                      "*",
                    ],
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":logs:us-east-1:123456789012:log-group//aws/ecs/containerinsights/",
                      {
                        "Ref": "GenEcsAgenticCluster67E30AF3",
                      },
                      "*:log-stream:*",
                    ],
                  ],
                },
              ],
            },
            {
              "Action": "ssm:GetParameters",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
                    },
                    ":ssm:us-east-1:123456789012:parameter/AmazonCloudWatch-*",
                  ],
                ],
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "GenEcsAgenticCloudWatchPolicyEA722562",
        "Roles": [
          {
            "Ref": "GenEcsAgenticTaskRoleC77573DF",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
