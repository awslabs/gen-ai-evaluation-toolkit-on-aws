{
  "name": "awssolutions-gen-ai-evaluation-toolkit-plugin-gen-agentic",
  "version": "2.0.1",
  "license": "Apache-2.0",
  "description": "GenAI-ETK ground truth generation plugin for generating test cases for agentic applications",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf node_modules dist build",
    "test": "jest --coverage",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "docs:generate-notices": "license-checker-rseidelsohn --production --excludePackagesStartingWith '@amzn;@awssolutions' --customPath license-checker.config.json --markdown > build/NOTICES.md",
    "docs:generate-sbom": "FETCH_LICENSE=true cdxgen --output build/bom.json",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\"",
    "typecheck": "tsc --noEmit",
    "audit:fix": "npm audit fix"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@cyclonedx/cdxgen": "11.1.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.2.3",
    "license-checker-rseidelsohn": "^4.4.2",
    "jest": "^29.7.0",
    "prettier": "3.5.3",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@genai-etk/plugin-gen-sdk": "file:../plugin-gen-sdk",
    "@aws-sdk/client-bedrock-runtime": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "ajv": "^8.17.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "tar-fs": ">=2.1.4 <3",
    "@cyclonedx/cdxgen": "11.1.7",
    "tar": ">=7.5.19",
    "@typescript-eslint/typescript-estree": {
      "minimatch": ">=9.0.7"
    },
    "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
    "fast-uri": ">=3.1.3"
  }
}
