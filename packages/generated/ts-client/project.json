{
  "name": "generated-ts-client",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "implicitDependencies": ["models"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "(cd $NX_WORKSPACE_ROOT && npm install)",
          "npm run build",
          "mkdir -p $NX_WORKSPACE_ROOT/output/node",
          "npm pack",
          "mv *.tgz $NX_WORKSPACE_ROOT/output/node"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "find . ! -name 'project.json' -delete",
        "cwd": "{projectRoot}"
      }
    }
  }
}
