{
  "name": "generated-ts-ssdk",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "implicitDependencies": ["models"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["(cd $NX_WORKSPACE_ROOT && npm install)", "npm run build"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "find . ! -name 'project.json' -delete",
        "cwd": "{projectRoot}"
      }
    }
  }
}
