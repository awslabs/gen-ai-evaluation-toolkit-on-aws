{
  "name": "plugin-gen-sdk",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json", "{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["install"]
    },
    "install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/package-lock.json"],
      "outputs": ["{projectRoot}/node_modules"],
      "options": {
        "command": "npm ci",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npm run lint", "npm run test"],
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["install"],
      "parallel": false
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run clean",
        "cwd": "{projectRoot}"
      }
    }
  }
}
