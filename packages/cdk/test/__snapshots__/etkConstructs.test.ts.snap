{
  "Description": "Stack for the GenAI Evaluation Toolkit: Datastore",
  "Resources": {
    "ArchiveAnnotationSchemaLambdaF2DE520E": {
      "DependsOn": [
        "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleDefaultPolicy3F95CF7A",
        "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleBF53621E",
      ],
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-L1",
              "reason": "Using latest Node.js LTS version (22.x)",
            },
            {
              "id": "AwsSolutions-IAM4",
              "reason": "Using AWS managed policies for Lambda execution role is AWS best practice",
            },
            {
              "id": "AwsSolutions-IAM5",
              "reason": "Wildcard permissions are necessary for Lambda to access CloudWatch Logs, X-Ray, and other AWS services",
            },
          ],
        },
      },
      "Properties": {
        "Architectures": [
          "arm64",
        ],
        "Code": Any<Object>,
        "Description": "Mark or unmark an annotation schema as archived to prevent or allow further use",
        "Environment": {
          "Variables": {
            "DYNAMO_TABLE_NAME": {
              "Fn::ImportValue": "GenAiEtk-Base:ExportsOutputRefDatastoreDdbTableD54D105938ED1670",
            },
            "S3_BUCKET_NAME": {
              "Fn::ImportValue": "GenAiEtk-Base:ExportsOutputRefDataStoreBucket0002DC8C3518599D",
            },
          },
        },
        "Handler": "index.handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ArchiveAnnotationSchemaLambdaLogGroup7B8D7E4A",
          },
        },
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleBF53621E",
            "Arn",
          ],
        },
        "Runtime": "nodejs24.x",
        "Timeout": 29,
        "TracingConfig": {
          "Mode": "Active",
        },
        "VpcConfig": {
          "SecurityGroupIds": [
            {
              "Fn::GetAtt": [
                "ArchiveAnnotationSchemaLambdaSecurityGroup432FE521",
                "GroupId",
              ],
            },
          ],
          "SubnetIds": [
            {
              "Fn::ImportValue": "TestVPCStack:ExportsOutputRefTestVPCPrivateSubnet1Subnet005D5ABE0341BEED",
            },
            {
              "Fn::ImportValue": "TestVPCStack:ExportsOutputRefTestVPCPrivateSubnet2Subnet45EC7DE34DC431C1",
            },
          ],
        },
      },
      "Type": "AWS::Lambda::Function",
    },
    "ArchiveAnnotationSchemaLambdaLogGroup7B8D7E4A": {
      "DeletionPolicy": "RetainExceptOnCreate",
      "Properties": {
        "RetentionInDays": 545,
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Retain",
    },
    "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleBF53621E": {
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-IAM5",
              "reason": "No way to avoid wildcards for log groups",
            },
          ],
        },
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "Minimal execution role for ServicePrincipal(lambda.amazonaws.com) to write into ArchiveAnnotationSchema-Lambda-LogGroup",
      },
      "Type": "AWS::IAM::Role",
    },
    "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleDefaultPolicy3F95CF7A": {
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
