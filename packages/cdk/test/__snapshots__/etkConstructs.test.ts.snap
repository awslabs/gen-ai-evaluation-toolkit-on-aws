              "Fn::ImportValue": "GenAiEtk-Base:ExportsOutputRefDataStoreBucket0002DC8C3518599D",
            },
          },
        },
        "Handler": "index.handler",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ArchiveAnnotationSchemaLambdaLogGroup7B8D7E4A",
          },
        },
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleBF53621E",
            "Arn",
          ],
        },
        "Runtime": "nodejs24.x",
        "Timeout": 29,
        "TracingConfig": {
          "Mode": "Active",
        },
        "VpcConfig": {
          "SecurityGroupIds": [
            {
              "Fn::GetAtt": [
                "ArchiveAnnotationSchemaLambdaSecurityGroup432FE521",
                "GroupId",
              ],
            },
          ],
          "SubnetIds": [
            {
              "Fn::ImportValue": "TestVPCStack:ExportsOutputRefTestVPCPrivateSubnet1Subnet005D5ABE0341BEED",
            },
            {
              "Fn::ImportValue": "TestVPCStack:ExportsOutputRefTestVPCPrivateSubnet2Subnet45EC7DE34DC431C1",
            },
          ],
        },
      },
      "Type": "AWS::Lambda::Function",
    },
