              "checkpoint.$": "$.taskOutput.checkpoint",
              "heartbeatSeconds.$": "$.heartbeatSeconds"
            },
            "Next": "EmitScoreTask"
          },
          "ScoreTaskDone": {
            "Type": "Pass",
            "Parameters": {
              "status": "COMPLETED",
