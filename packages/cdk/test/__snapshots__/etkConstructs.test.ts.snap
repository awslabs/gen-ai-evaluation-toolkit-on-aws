{
  "Description": "Stack for the GenAI Evaluation Toolkit: Datastore",
  "Resources": {
    "ArchiveAnnotationSchemaLambdaF2DE520E": {
      "DependsOn": [
        "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleDefaultPolicy3F95CF7A",
        "ArchiveAnnotationSchemaLambdaLogGroupServiceRoleBF53621E",
      ],
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-L1",
              "reason": "Using latest Node.js LTS version (22.x)",
            },
            {
              "id": "AwsSolutions-IAM4",
              "reason": "Using AWS managed policies for Lambda execution role is AWS best practice",
            },
            {
              "id": "AwsSolutions-IAM5",
              "reason": "Wildcard permissions are necessary for Lambda to access CloudWatch Logs, X-Ray, and other AWS services",
            },
          ],
        },
      },
      "Properties": {
        "Architectures": [
          "arm64",
        ],
        "Code": Any<Object>,
        "Description": "Mark or unmark an annotation schema as archived to prevent or allow further use",
        "Environment": {
          "Variables": {
            "DYNAMO_TABLE_NAME": {
              "Fn::ImportValue": "GenAiEtk-Base:ExportsOutputRefDatastoreDdbTableD54D105938ED1670",
