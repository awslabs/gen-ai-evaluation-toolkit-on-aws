            {
              "Action": [
                "xray:PutTraceSegments",
                "xray:PutTelemetryRecords",
                "xray:GetSamplingRules",
                "xray:GetSamplingTargets",
              ],
              "Effect": "Allow",
              "Resource": "*",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "TestStateMachineLogGroupServiceRoleDefaultPolicyCC1914D1",
        "Roles": [
          {
            "Ref": "TestStateMachineLogGroupServiceRoleD78C6760",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
  },
}
