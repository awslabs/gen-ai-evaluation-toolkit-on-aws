              "reason": "Using AWS managed policies for Step Function execution role is AWS best practice",
            },
            {
              "id": "AwsSolutions-IAM5",
              "reason": "Wildcard permissions are necessary for Step Functions to access CloudWatch Logs, X-Ray, and invoke Lambda functions",
            },
          ],
        },
      },
      "Properties": {
        "DefinitionString": "{"StartAt":"TestPass","States":{"TestPass":{"Type":"Pass","End":true}}}",
        "LoggingConfiguration": {
