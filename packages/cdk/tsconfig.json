{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "noEmit": false,
    "allowJs": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@common": ["src/common"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/common/config/*"],
      "@constructs": ["src/common/constructs"],
      "@constructs/*": ["src/common/constructs/*"],
      "@lambdas": ["src/evaluation/lambdas"],
      "@lambdas/*": ["src/evaluation/lambdas/*"],
      "@secured": ["src/common/constructs/secured"],
      "@secured/*": ["src/common/constructs/secured/*"],
      "@stepfunction": ["src/common/constructs/stepfunction"],
      "@stepfunction/*": ["src/common/constructs/stepfunction/*"],
      "@plugins": ["src/plugins"],
      "@plugins/*": ["src/plugins/*"],
      "@datastore": ["src/datastore"],
      "@datastore/*": ["src/datastore/*"],
      "@evaluation": ["src/evaluation"],
      "@evaluation/*": ["src/evaluation/*"],
      "@experiment": ["src/experiment"],
      "@experiment/*": ["src/experiment/*"],
      "@generation": ["src/generation"],
      "@generation/*": ["src/generation/*"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage", "assets", "**/*.spec.ts", "**/*.test.ts"],
  "include": ["src", "test", "jest.config.ts"]
}
