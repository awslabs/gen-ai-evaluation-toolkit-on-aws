{
  "name": "@awssolutions/gen-ai-evaluation-toolkit-cdk",
  "description": "Gen AI Evaluation Toolkit on AWS: CDK constructs",
  "version": "2.0.1",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/types/src/index.d.ts",
  "author": "Amazon Web Services",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist/*",
    "assets/*",
    "NOTICES.md"
  ],
  "scripts": {
    "clean": "rm -rf node_modules build dist assets",
    "install:assets": "mkdir -p assets && cp ../generated/open-api/openapi.json ../experiment-lambdas/build/experiment-lambdas.zip ../python-api/build/python-api.zip src/evaluator/orchestration-asl.json assets/",
    "prebuild": "npm run install:assets && npm run build:lambdas",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "build:lambdas": "tsx scripts/build-lambdas.ts",
    "build": "tsc && tsc-alias",
    "test": "jest --coverage --silent",
    "test:update": "jest --silent -u",
    "test:watch": "jest --watch",
    "lint": "eslint --cache src test && prettier --list-different --cache src test",
    "format": "eslint --fix --cache src test && prettier --write --cache .",
    "fix": "npm run test:update && npm run format",
    "release": "npm run lint && npm run test && npm run build",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@aws-lambda-powertools/commons": "2.12.0",
    "@aws-lambda-powertools/logger": "2.12.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-ecs": "^3.1000.0",
    "@aws-sdk/client-eventbridge": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-scheduler": "^3.1000.0",
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@aws-sdk/client-sfn": "^3.1000.0",
    "@aws-sdk/client-sns": "^3.1000.0",
    "@aws-sdk/client-sqs": "^3.1000.0",
    "@aws-sdk/client-ssm": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@aws-sdk/util-dynamodb": "^3.996.1",
    "@aws-smithy/server-apigateway": "1.0.0-alpha.10",
    "@aws-smithy/server-common": "1.0.0-alpha.10",
    "@awssolutions/gen-ai-evaluation-toolkit-ts-client": "file:../generated/ts-client",
    "@awssolutions/gen-ai-evaluation-toolkit-ts-ssdk": "file:../generated/ts-ssdk",
    "@smithy/smithy-client": "^4.0.0",
    "@smithy/types": "^4.0.0",
    "aws-xray-sdk": "^3.3.5",
    "aws-xray-sdk-core": "^3.5.3",
    "cdk-ecr-deployment": "^4.0",
    "cdk-monitoring-constructs": "9.5.0",
    "cdk-nag": "^2.35.35",
    "change-case": "4.1.2",
    "esbuild": "^0.25.0",
    "openapi-types": "12.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@smithy/util-stream": "^4.7.6",
    "@stylistic/eslint-plugin-ts": "^2.10.1",
    "@tsconfig/node20": "^20.1.0",
    "@tsconfig/strictest": "2.0.5",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "aws-cdk-lib": "^2.257.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.5.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^30.0.5",
    "jest-cdk-snapshot": "^2.2.5",
    "jest-cli": "^30.0.5",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.19.2",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.5.1",
    "esbuild": "^0.25.0"
  },
  "bundleDependencies": [
    "@awssolutions/gen-ai-evaluation-toolkit-ts-ssdk",
    "@awssolutions/gen-ai-evaluation-toolkit-ts-client"
  ]
}
