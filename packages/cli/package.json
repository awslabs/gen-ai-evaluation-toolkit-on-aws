{
  "name": "@awssolutions/gen-ai-evaluation-toolkit-cli",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "description": "Gen AI Evaluation Toolkit on AWS: CLI",
  "main": "./src/main.ts",
  "bin": {
    "genai-etk": "./dist/genai-etk"
  },
  "files": [
    "dist",
    "assets",
    "NOTICES.md"
  ],
  "scripts": {
    "install:assets": "mkdir -p assets && cp ../models/build/model.json ./assets/",
    "clean": "rm -rf dist build node_modules coverage assets",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run format && npm run lint:fix",
    "format": "prettier --cache --write --ignore-unknown .",
    "format:check": "prettier --cache --list-different --ignore-unknown .",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "build": "webpack --config webpack.config.js",
    "build:watch": "WEBPACK_WATCH=true webpack --watch --config webpack.config.js",
    "docs:generate-notices": "license-checker-rseidelsohn --production --excludePackagesStartingWith '@amzn;@awssolutions' --customPath ./license-checker.config.json --markdown > NOTICES.md",
    "docs:generate-manual": "ts-node -r tsconfig-paths/register --compilerOptions '{\"target\":\"ES2020\"}' src/doc/doc-gen.ts",
    "docs:generate": "npm run docs:generate-notices && npm run docs:generate-manual",
    "dev": "concurrently \"npm run build:watch\" \"npm run dev:link\"",
    "dev:link": "npm link --local .",
    "dev:unlink": "npm uninstall -g @awssolutions/gen-ai-evaluation-toolkit-cli",
    "test": "jest",
    "test:update": "jest --silent -u",
    "test:ci": "jest --coverage --silent",
    "test:watch": "jest --watch",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@aws-sdk/client-sagemaker": "^3.760.0",
    "@awssolutions/gen-ai-evaluation-toolkit-client": "file:../generated/ts-client",
    "@types/fs-extra": "11.0.4",
    "commander": "^12.1.0",
    "fs-extra": "11.3.0",
    "open": "^8.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@smithy/types": "^4.14.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "concurrently": "^9.2.3",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "handlebars": "4.7.9",
    "handlebars-loader": "1.7.3",
    "jest": "^30.0.5",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "^5.5.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=8"
  },
  "keywords": [
    "aws",
    "cli",
    "genai-etk"
  ],
  "sideEffects": false
}
