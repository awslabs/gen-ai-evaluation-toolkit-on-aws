{
  "name": "cli",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "implicitDependencies": ["models", "generated-ts-client"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/packages/models/build",
        "{workspaceRoot}/packages/generated/ts-client"
      ],
      "outputs": ["{projectRoot}/assets"],
      "options": {
        "commands": ["rm -rf assets", "npm run install:assets"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["install"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "npm run build",
          "mkdir -p $NX_WORKSPACE_ROOT/output/node",
          "npm pack",
          "mv *.tgz $NX_WORKSPACE_ROOT/output/node"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npm run lint", "npm run test"],
        "cwd": "{projectRoot}",
        "parallel": false
      },
      "dependsOn": ["install"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run clean",
        "cwd": "{projectRoot}"
      }
    }
  }
}
